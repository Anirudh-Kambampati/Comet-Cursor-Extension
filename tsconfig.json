{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "ESNext",
    "moduleResolution":  "bundler",

    "lib": ["ES2020", "DOM"],

    "types": ["chrome"],

    "strict":                  true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax":    true,
    "moduleDetection":         "force",

    "skipLibCheck": true,
    "noEmit":       true
  }
}